{
    "name": "omnipay/tests",
    "type": "library",
    "description": "Testing components for Omnipay payment processing library",
    "keywords": ["omnipay", "phpunit", "testing"],
    "homepage": "https://github.com/thephpleague/omnipay-tests",
    "license": "MIT",
    "authors": [
        {
            "name": "Adrian Macneil",
            "email": "adrian@adrianmacneil.com"
        },
        {
            "name": "Barry vd. Heuvel",
            "email": "barryvdh@gmail.com"
        },
        {
            "name": "Omnipay Contributors",
            "homepage": "https://github.com/thephpleague/omnipay-tests/contributors"
        }
    ],
    "autoload": {
        "psr-4": {
            "Omnipay\\Tests\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omnipay\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "guzzlehttp/psr7": "^2.7 || ^3.2",
        "mockery/mockery": "^1.6.15",
        "php-http/discovery": "^1.20",
        "php-http/mock-client": "^1.6.1",
        "phpunit/phpunit": "^11.5 || ^12.5 || ^13.4"
    },
    "require-dev": {
        "omnipay/common": "^3.5",
        "php-http/guzzle7-adapter": "^1.1",
        "symfony/http-foundation": "^6.4 || ^7.3 || ^8.1"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "5.0.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "prefer-stable": true
}
